{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pescheria-pessano",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "FISH_ADMIN_PIN": "2134"
  }
}
